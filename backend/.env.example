# SEVA VAANI Backend Environment Configuration
# Copy this file to .env and configure your environment settings

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Database (Canonical SQLite path)
DATABASE_URL=sqlite:///./seva_vaani.db

# LLM Provider Configuration
# Options: 'ollama' | 'cloud' | 'mock'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SEC=5.0

# Optional Cloud LLM Fallback (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=

# Speech & Translation (Bhashini ULCA / Azure / OpenAI)
BHASHINI_API_KEY=
