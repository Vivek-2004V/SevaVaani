# SEVA VAANI Production Environment Configuration Template
APP_ENV=production
PROJECT_NAME="SEVA VAANI"
VERSION=1.0.0

# Database Configuration (PostgreSQL with Connection Pooling)
DATABASE_URL=postgresql://seva_vaani:YOUR_STRONG_PASSWORD@postgres:5432/seva_vaani_db
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Distributed Cache & Task Broker (Redis)
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# Security & Proxies
TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
ALLOWED_ORIGINS=["https://sevavaani.gov.in","https://app.sevavaani.gov.in"]
FRONTEND_ORIGIN=https://sevavaani.gov.in

# Speech & AI Providers
STT_PROVIDER=bhashini
TTS_PROVIDER=bhashini
BHASHINI_API_KEY=YOUR_BHASHINI_API_KEY
BHASHINI_USER_ID=YOUR_BHASHINI_USER_ID

# Field Encryption Secret (Fernet key - 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=YOUR_FERNET_KEY_HERE
